# Plantilla sin credenciales. Spring NO carga .env automaticamente.
# Exportar estas variables o crear application-local.yml segun SEGURIDAD_SECRETOS.md.
POSTGRES_URL=jdbc:postgresql://localhost:5432/ciudadanos_m1
POSTGRES_USER=ciudadanos_app
POSTGRES_PASSWORD=
APP_JWT_SECRET=
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Origenes exactos del frontend separados por coma; no usar comodines.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5173,http://127.0.0.1:5173
