          "required": true,
          "content": {
            "application/json": {
              "example": {
                "tipo": "CIUDADANO",
                "cuit": "20-40123456-7",
                "password": "clave-segura-1",
                "dni": "40123456",
                "nombre": "Ana",
                "apellido": "Perez",
