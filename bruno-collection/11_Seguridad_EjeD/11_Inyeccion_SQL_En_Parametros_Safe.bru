meta {
  name: 11_Inyeccion_SQL_En_Parametros_Safe
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/ciudadanos/dni/12345678' OR '1'='1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_empleado}}
}

tests {
  test("Inyección SQL no rompe la consulta ni filtra datos (devuelve 400 o 404 seguro)", function() {
    expect([400, 404]).to.include(res.getStatus());
  });
}
