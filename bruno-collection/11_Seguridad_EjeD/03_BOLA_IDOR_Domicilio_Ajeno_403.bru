meta {
  name: 03_BOLA_IDOR_Domicilio_Ajeno_403
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/ciudadanos/2/domicilios
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_ciudadano}}
}

tests {
  test("Status code is 403 Forbidden al consultar domicilios de otro ciudadano (BOLA/IDOR)", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
