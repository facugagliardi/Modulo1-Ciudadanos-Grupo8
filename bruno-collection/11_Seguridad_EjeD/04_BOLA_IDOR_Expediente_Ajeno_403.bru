get {
  url: {{baseUrl}}/expedientes/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_ciudadano}}
}

tests {
  test("Status code is 403 Forbidden para expediente de tercero sin permiso (BOLA/IDOR)", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
