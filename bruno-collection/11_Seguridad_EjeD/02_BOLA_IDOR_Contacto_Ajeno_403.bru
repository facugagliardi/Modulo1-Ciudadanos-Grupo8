meta {
  name: 02_BOLA_IDOR_Contacto_Ajeno_403
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ciudadanos/2/contactos
  body: none
  auth: bearer
}

auth:bearer {
  token: {{jwt_ciudadano}}
}

tests {
  test("Status code is 403 Forbidden al consultar contactos de otro ciudadano (BOLA/IDOR)", function() {
    expect(res.getStatus()).to.equal(403);
  });
}
